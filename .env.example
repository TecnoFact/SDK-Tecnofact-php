# TecnoFact SDK - Variables de Entorno de Ejemplo
# Copia este archivo a .env y completa los valores

TECN_FACT_EMAIL=tu-email@ejemplo.com
TECN_FACT_PASSWORD=tu-password-aqui
# Solo production disponible por ahora (sandbox aún no existe)
TECN_FACT_ENVIRONMENT=production
TECN_FACT_TIMEOUT=30
TECN_FACT_RETRIES=3
# Verificación TLS del servidor. Valores:
#   true  -> verifica con las CA del sistema (default, seguro)
#   false -> desactiva la verificación (INSEGURO, solo desarrollo)
#   /ruta/al/bundle.pem -> usa un bundle de CA propio (p. ej. con el intermedio del panel)
TECN_FACT_VERIFY_SSL=true
